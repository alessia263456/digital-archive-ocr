{
	persist_config off
	servers {
		protocols h1 h2
	}
}

arhivar.swedencentral.cloudapp.azure.com {
	route {
		basic_auth {
			import /run/secrets/placeholder-auth
		}
		header Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		@laravel path /up /api /api/* /sanctum /sanctum/*
		reverse_proxy @laravel backend:8000 {
			header_up -Authorization
		}
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
