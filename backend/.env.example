APP_ENV=local
APP_KEY=
APP_URL=http://localhost:8000
APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,arhivar.swedencentral.cloudapp.azure.com

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Leave SESSION_DOMAIN unset to use a host-only cookie.
# Set SESSION_SECURE_COOKIE=true in production (HTTPS).

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=archive
DB_USERNAME=archive
DB_PASSWORD=

DOCUMENTS_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_DEFAULT_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=false
